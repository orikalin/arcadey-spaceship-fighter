[layer_names]

3d_physics/layer_1="Terrain"
3d_physics/layer_2="Player"
3d_physics/layer_3="enemy_hitbox"
3d_physics/layer_4="sights"
3d_physics/layer_5="bullets"
3d_physics/layer_6="enemy_physics"
3d_physics/layer_7="enemy_hurtbox"
3d_physics/layer_8="sights_limit"
3d_physics/layer_9="area_triggers"

[limbo_ai]

behavior_tree/user_task_dirs=PackedStringArray("res://ai/tasks", "res://Assets/Entities/Enemies/SpikeBug/ai/tasks")

[phantom_camera]

tips/show_jitter_tips=false

[physics]

common/max_physics_steps_per_frame=12
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=12
jolt_physics_3d/simulation/position_steps=12
jolt_physics_3d/simulation/areas_detect_static_bodies=true
jolt_physics_3d/simulation/penetration_slop=0.01
jolt_physics_3d/simulation/speculative_contact_distance=0.2
jolt_physics_3d/motion_queries/recovery_iterations=6
jolt_physics_3d/motion_queries/recovery_amount=0.3
3d/solver/solver_iterations=32

[rendering]

textures/vram_compression/import_etc2_astc=true
