&"VisibleOnScreenNotifier3D": 0,
&"VoxelGI": 0
},
"Custom": {
&"AreaLight3D": 0,
&"Camera3D": 0,
&"CollisionObject3D": 0,
&"CollisionPolygon3D": 0,
&"CollisionShape3D": 0,
&"Light3D": 0,
&"PhysicalBone3D": 0,
&"RayCast3D": 0,
&"SpringArm3D": 0,
&"SpringBoneCollision3D": 0,
&"SpringBoneSimulator3D": 0
},
"None": {}
}

[editor_plugins]

enabled=PackedStringArray("res://addons/PathMesh3D/plugin.cfg", "res://addons/area_lights/plugin.cfg", "res://addons/gizmo_presets/plugin.cfg", "res://addons/light_shafts/plugin.cfg", "res://addons/lines_and_trails_3d/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/seven_segment_display/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/tile_path_3d/plugin.cfg")

[global_group]

terrain=""
targetable=""
visible_target="target belongs to this group if it is visible on screen"
damage_dealer=""

