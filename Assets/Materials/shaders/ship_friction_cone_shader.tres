code = "shader_type spatial;
render_mode blend_add, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_disabled, unshaded, shadows_disabled, ambient_light_disabled;

uniform vec4 cone_color : source_color;
uniform sampler2D tex_frg_3;
uniform sampler2D tex_frg_4 : source_color;
uniform float max_alpha = 1.0;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = cone_color;


// UVFunc:11
	vec2 n_in11p1 = vec2(8.00000, 0.40000);
	vec2 n_in11p2 = vec2(0.00000, 0.00000);
	vec2 n_out11p0 = (UV - n_in11p2) * n_in11p1 + n_in11p2;


// Input:8
	float n_out8p0 = TIME;


// VectorOp:9
	vec2 n_in9p1 = vec2(0.00000, 2.00000);
	vec2 n_out9p0 = vec2(n_out8p0) + n_in9p1;


// UVFunc:7
	vec2 n_in7p1 = vec2(1.50000, 1.00000);
	vec2 n_out7p0 = n_out9p0 * n_in7p1 + n_out11p0;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, n_out7p0);
	float n_out3p1 = n_out3p0.r;


// FloatOp:10
	float n_in10p1 = 10.00000;
	float n_out10p0 = pow(n_out3p1, n_in10p1);


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, UV);


// FloatOp:5
	float n_out5p0 = n_out10p0 - n_out4p0.x;


// FloatParameter:12
	float n_out12p0 = max_alpha;


// Clamp:6
	float n_in6p1 = 0.00000;
	float n_out6p0 = clamp(n_out5p0, n_in6p1, n_out12p0);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out6p0;


}
"
